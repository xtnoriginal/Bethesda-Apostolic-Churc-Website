DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-a-random-secret"      #To be changed later
NEXTAUTH_URL="http://localhost:3000"

# Production origin. Canonical URLs, Open Graph tags and sitemap.xml are all
# built from this — set it to the real domain before going live.
# Must be set at BUILD time: robots.txt and sitemap.xml are prerendered.
SITE_URL="https://REPLACE-WITH-YOUR-DOMAIN"
