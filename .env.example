DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Production origin. Canonical URLs, Open Graph tags and sitemap.xml are all
# built from this — set it to the real domain before going live.
# Must be set at BUILD time: robots.txt and sitemap.xml are prerendered.
SITE_URL="https://REPLACE-WITH-YOUR-DOMAIN"

# Video storage for archive items and course lessons (Cloudflare R2 or AWS S3).
# Admins upload straight from the browser to this bucket; see src/lib/storage.js.
# R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_REGION="auto"
# AWS: leave S3_ENDPOINT empty and set S3_REGION to the bucket's region.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public origin the bucket is served from (custom domain or https://pub-xxxx.r2.dev)
S3_PUBLIC_URL=""
